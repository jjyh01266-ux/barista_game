{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README_DEPLOY.md",
      "**/.*",
      "**/node_modules/**",
      "assets/bgm.mp3",
      "pdf_images/**",
      "pdf_contact_sheet.jpg"
    ],
    "headers": [
      {
        "source": "**/*.@(png|jpg|jpeg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
